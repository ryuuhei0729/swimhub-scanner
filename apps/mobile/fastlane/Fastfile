default_platform(:ios)

# App Store Connect API キー (~/.appstoreconnect/ に mode 600 で配置。リポジトリツリー外)
ASC_KEY_ID    = ENV["ASC_KEY_ID"]    || "Y9S6G7KW9V"
ASC_KEY_PATH  = ENV["ASC_KEY_PATH"]  || File.expand_path("~/.appstoreconnect/AuthKey_Y9S6G7KW9V.p8")
ASC_ISSUER_ID = ENV["ASC_ISSUER_ID"] || "6a00eab9-1ee2-474d-82a1-6ec27420ef53"

# 2026-07 に追加した新ロケール
NEW_LANGUAGES = ["ko", "zh-Hans", "de-DE"]

# 「最新情報 (What's New)」が未入力で審査提出できないロケール (2026-07-21)
RELEASE_NOTES_LANGUAGES = ["de-DE", "en-CA", "en-AU", "en-GB"]

def swimhub_api_key
  UI.user_error!("ASC キーが見つかりません: #{ASC_KEY_PATH}") unless File.exist?(ASC_KEY_PATH)
  app_store_connect_api_key(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    key_filepath: ASC_KEY_PATH,
    in_house: false
  )
end

platform :ios do
  desc "新ロケールのメタデータ (概要/キーワード等) を App Store Connect にアップロード"
  lane :upload_metadata do |options|
    languages = options[:languages] || NEW_LANGUAGES
    deliver(
      api_key: swimhub_api_key,
      app_identifier: "app.swim-hub.scanner",
      metadata_path: File.expand_path("./metadata", __dir__),
      languages: languages,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
  end

  desc "編集中バージョンの「最新情報 (release_notes)」を App Store Connect に反映"
  desc "options: languages (default: 最新情報が未入力の4ロケール)"
  lane :upload_release_notes do |options|
    languages = options[:languages] || RELEASE_NOTES_LANGUAGES
    deliver(
      api_key: swimhub_api_key,
      app_identifier: "app.swim-hub.scanner",
      metadata_path: File.expand_path("./metadata", __dir__),
      languages: languages,
      skip_binary_upload: true,
      skip_screenshots: true,
      # release_notes はバージョン紐付けメタデータのため version 更新はスキップしない
      skip_app_version_update: false,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
  end

  desc "スクショ (素のまま) を App Store Connect にアップロード"
  desc "options: languages (default: 新ロケールのみ)"
  lane :upload_screenshots do |options|
    languages = options[:languages] || NEW_LANGUAGES
    deliver(
      api_key: swimhub_api_key,
      app_identifier: "app.swim-hub.scanner",
      screenshots_path: File.expand_path("./screenshots", __dir__),
      languages: languages,
      # スクショのみ更新（バイナリ・メタデータ・バージョンには触れない）
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      sync_screenshots: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true # HTML プレビューの確認をスキップ（CI/非対話実行用）
    )
  end

  desc "検索に効く項目 (名前・サブタイトル・キーワード) と宣伝文だけを更新する。概要などには触れない"
  desc "metadata/<locale>/{name,subtitle,keywords,promotional_text}.txt を読む"
  desc "名前・サブタイトル・キーワードは編集中のバージョンがあるときしか書き込めない。無いときは公開中の値と比べるだけ"
  desc "options: apply:true で実際に書き込む (既定は確認のみ)"
  lane :upload_search_metadata do |options|
    apply = options[:apply].to_s == "true"
    limits = { "name" => 30, "subtitle" => 30, "keywords" => 100, "promotional_text" => 170 }

    swimhub_api_key
    app = Spaceship::ConnectAPI::App.find("app.swim-hub.scanner")
    UI.user_error!("アプリが見つかりません: app.swim-hub.scanner") unless app
    platform = Spaceship::ConnectAPI::Platform::IOS
    info = app.fetch_edit_app_info
    version = app.get_edit_app_store_version(platform: platform)
    if apply && !(info && version)
      UI.user_error!("編集中のバージョンがありません。App Store Connect で新しいバージョンを作ってから実行する")
    end
    UI.important("編集中のバージョンが無いので公開中の値と比べる") unless info && version
    info ||= app.fetch_live_app_info
    version ||= app.get_live_app_store_version(platform: platform)
    UI.message("対象バージョン: #{version.version_string} (#{version.app_store_state})")

    metadata_dir = File.expand_path("./metadata", __dir__)
    read_field = lambda do |locale, field|
      path = File.join(metadata_dir, locale, "#{field}.txt")
      return nil unless File.exist?(path)
      text = File.read(path).strip
      UI.user_error!("#{locale}/#{field}: #{limits[field]} 文字を超えています (#{text.length})") if text.length > limits[field]
      text.empty? ? nil : text
    end

    info.get_app_info_localizations.each do |loc|
      attrs = { name: read_field.call(loc.locale, "name"), subtitle: read_field.call(loc.locale, "subtitle") }.compact
      next UI.important("#{loc.locale}: name/subtitle が無いのでスキップ") if attrs.empty?
      UI.message("#{loc.locale}: 名前「#{loc.name}」→「#{attrs[:name]}」 / サブタイトル「#{loc.subtitle}」→「#{attrs[:subtitle]}」")
      loc.update(attributes: attrs) if apply
    end

    version.get_app_store_version_localizations.each do |loc|
      attrs = { keywords: read_field.call(loc.locale, "keywords"), promotionalText: read_field.call(loc.locale, "promotional_text") }.compact
      next UI.important("#{loc.locale}: keywords/promotional_text が無いのでスキップ") if attrs.empty?
      UI.message("#{loc.locale}: キーワード「#{loc.keywords}」→「#{attrs[:keywords]}」(#{attrs[:keywords].to_s.length} 文字)")
      UI.message("#{loc.locale}: 宣伝文「#{loc.promotional_text}」→「#{attrs[:promotionalText]}」") if attrs[:promotionalText]
      loc.update(attributes: attrs) if apply
    end

    UI.success(apply ? "検索用メタデータを更新しました" : "確認のみ (書き込むには apply:true)")
  end
end
